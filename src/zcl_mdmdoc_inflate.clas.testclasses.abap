  METHOD stored_block.
    DATA lv_z TYPE xstring.
    lv_z = '7801011700E8FF4254202873746F72656420626C6F636B2920546A20455459FE075B'.
    DATA lv_exp TYPE xstring.
    lv_exp = '4254202873746F72656420626C6F636B2920546A204554'.
    cl_abap_unit_assert=>assert_equals( act = unwrap_and_decode( lv_z ) exp = lv_exp ).
  ENDMETHOD.

  METHOD overlapping_match.
    " a run of 120 identical bytes forces dist < length copies
    DATA lv_z TYPE xstring.
    lv_z = '789C730A51D0701C20A0A91092A5E01A020080962117'.
    DATA lv_exp TYPE xstring.
    lv_exp =
      '4254202841414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141' &&
      '4141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141414141' &&
      '4141414141414141414141414141414141414141414141412920546A204554'.
    cl_abap_unit_assert=>assert_equals( act = unwrap_and_decode( lv_z ) exp = lv_exp ).
  ENDMETHOD.

  METHOD corrupt_no_dump.
    " flipped bytes inside a valid envelope: must return ev_ok = false, never dump
    DATA lv_bad TYPE xstring.
    lv_bad = 'ED8FFF0AC24018847B9F624A05FFFF8F18936E77'.
    zcl_mdmdoc_inflate=>decompress(
      EXPORTING iv_data = lv_bad
      IMPORTING ev_raw = DATA(lv_raw) ev_ok = DATA(lv_ok) ).
    cl_abap_unit_assert=>assert_false( lv_ok ).
  ENDMETHOD.

  METHOD not_zlib_rejected.
    " gzip magic is not a zlib envelope
    DATA lv_gz TYPE xstring.
    lv_gz = '1F8B0800000000000003AAAAAAAAAAAAAAAA'.
    zcl_mdmdoc_inflate=>unwrap_zlib(
      EXPORTING iv_data = lv_gz
      IMPORTING ev_deflate = DATA(lv_deflate) ev_is_zlib = DATA(lv_is_zlib) ).
    cl_abap_unit_assert=>assert_false( lv_is_zlib ).
  ENDMETHOD.

ENDCLASS.
