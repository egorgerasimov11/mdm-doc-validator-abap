*"* use this source file for your ABAP unit test classes
" Fixtures are real zlib output (Python zlib.compress) — one per DEFLATE block type,
" regenerable via tools/gen_flate_fixtures.py. Raw payloads are PDF content operators.
CLASS ltcl_inflate DEFINITION FINAL FOR TESTING
  DURATION SHORT
  RISK LEVEL HARMLESS.

  PRIVATE SECTION.
    METHODS unwrap_and_decode
      IMPORTING iv_zlib       TYPE xstring
      RETURNING VALUE(rv_raw) TYPE xstring.

    METHODS fixed_huffman      FOR TESTING.
    METHODS dynamic_huffman    FOR TESTING.
    METHODS stored_block       FOR TESTING.
    METHODS overlapping_match  FOR TESTING.
    METHODS corrupt_no_dump    FOR TESTING.
    METHODS not_zlib_rejected  FOR TESTING.
ENDCLASS.

CLASS ltcl_inflate IMPLEMENTATION.

  METHOD unwrap_and_decode.
    zcl_mdmdoc_inflate=>unwrap_zlib(
      EXPORTING iv_data = iv_zlib
      IMPORTING ev_deflate = DATA(lv_deflate) ev_is_zlib = DATA(lv_is_zlib) ).
    cl_abap_unit_assert=>assert_true( lv_is_zlib ).
    zcl_mdmdoc_inflate=>decompress(
      EXPORTING iv_data = lv_deflate
      IMPORTING ev_raw = rv_raw ev_ok = DATA(lv_ok) ).
    cl_abap_unit_assert=>assert_true( lv_ok ).
  ENDMETHOD.

  METHOD fixed_huffman.
    DATA lv_z TYPE xstring.
    lv_z =
      '789C730A51D0773354303450084953303550303700B2521434DC72124B521532527372F215D28AF27315A27C5D7C5DFC9D35' &&
      '1542B2145C430087750EF6'.
    DATA lv_exp TYPE xstring.
    lv_exp =
      '4254202F4631203130205466203530203730302054642028466C6174652068656C6C6F2066726F6D205A4D444D444F432920' &&
      '546A204554'.
    cl_abap_unit_assert=>assert_equals( act = unwrap_and_decode( lv_z ) exp = lv_exp ).
  ENDMETHOD.

