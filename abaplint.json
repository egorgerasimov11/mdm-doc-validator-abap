{
  "global": {
    "files": "/src/**/*.*",
    "exclude": [
      "zcl_mdmdoc_mdg_reader\\.clas\\.abap$",
      "zcl_mdmdoc_mdg_map\\.clas\\.abap$",
      "zcl_mdg_bp_field_derr_val\\.clas\\.abap$",
      "zmdmdoc_mdg_discover\\.prog\\.abap$",
      "zmdmdoc_doctor\\.prog\\.abap$"
    ]
  },
  "dependencies": [
    {
      "url": "https://github.com/abaplint/deps",
      "folder": "/deps",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v750",
    "errorNamespace": "^(Z|Y|LCL_|LTCL_)"
  },
  "rules": {
    "parser_error": true,
    "check_syntax": true,
    "unknown_types": true,
    "check_ddic": true,
    "implement_methods": true,
    "method_implemented_twice": true,
    "superclass_final": true,
    "unreachable_code": true,
    "line_length": {
      "length": 140
    }
  }
}
